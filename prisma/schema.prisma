// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  online
  offline
}

enum DeviceType {
  GATEWAY
  ROUTER
  SWITCH
  ACCESS_POINT
  CLIENT
  SERVER
  UNKNOWN
}

enum PortAdminStatus {
  UP
  DOWN
  UNKNOWN
}

enum PortOperStatus {
  UP
  DOWN
  UNKNOWN
}

enum PortDuplex {
  FULL
  HALF
  UNKNOWN
}

enum PoeStatus {
  POWERED
  OFF
  UNSUPPORTED
  UNKNOWN
}

enum TopologyLinkType {
  ETHERNET
  WIRELESS
  VPN
  UNKNOWN
}

enum TopologyLinkStatus {
  UP
  DOWN
  DEGRADED
  UNKNOWN
}

enum DiscoverySource {
  MANUAL
  SNMP
  LLDP
  CDP
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  DEVICE_CREATED
  DEVICE_UPDATED
  DEVICE_DELETED
}

enum AiTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AgentStepType {
  MODEL_CALL
  TOOL_CALL
  TOOL_RESULT
  FINAL_ANSWER
}

enum AgentStepStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ConversationMessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id        String                @id @default(cuid())
  ownerId   Int
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  busy      Boolean               @default(false)
  messages  ConversationMessage[]
  tasks     AiTask[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([ownerId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String                  @id @default(cuid())
  conversationId String
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  taskId         String
  task           AiTask                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role           ConversationMessageRole
  content        String                  @db.Text
  sequence       Int
  createdAt      DateTime                @default(now())

  @@unique([conversationId, sequence])
  @@unique([taskId, role])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model AiTask {
  id             String        @id @default(cuid())
  prompt         String        @db.Text
  status         AiTaskStatus  @default(PENDING)
  result         String?       @db.Text
  errorMessage   String?       @db.Text
  attempts       Int           @default(0)
  retryCount     Int           @default(0)
  lockedBy       String?       @db.VarChar(255)
  leaseToken     String?       @unique @db.Uuid
  leaseExpiresAt DateTime?
  ownerId        Int
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  steps          AgentStep[]
  messages       ConversationMessage[]

  @@index([ownerId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@map("ai_tasks")
}

model AgentStep {
  id           String          @id @default(cuid())
  taskId       String
  task         AiTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type         AgentStepType
  status       AgentStepStatus @default(RUNNING)
  sequence     Int
  input        String?         @db.Text
  output       String?         @db.Text
  errorMessage String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([taskId, sequence])
  @@index([taskId, createdAt])
  @@map("agent_steps")
}

model AuditLog {
  id           Int         @id @default(autoincrement())
  action       AuditAction
  resourceType String      @db.VarChar(50)
  resourceId   String?     @db.VarChar(100)
  actorId      Int?
  actor        User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NetworkSite {
  id               String         @id @default(cuid())
  name             String         @db.VarChar(100)
  ownerId          Int
  owner            User           @relation("UserSites", fields: [ownerId], references: [id], onDelete: Cascade, map: "network_sites_ownerId_fkey")
  topologyRevision Int            @default(0)
  devices          Device[]
  topologyLinks    TopologyLink[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([ownerId, name])
  @@unique([id, ownerId])
  @@index([ownerId, updatedAt])
  @@map("network_sites")
}

model Device {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar(100)
  ip               String         @db.Inet
  portCount        Int
  status           DeviceStatus   @default(offline)
  type             DeviceType     @default(UNKNOWN)
  macAddress       String?        @db.VarChar(17)
  serialNumber     String?        @db.VarChar(100)
  vendor           String?        @db.VarChar(100)
  model            String?        @db.VarChar(100)
  lastSeenAt       DateTime?
  metadata         Json?
  ownerId          Int
  owner            User           @relation("UserDevices", fields: [ownerId], references: [id], onDelete: Cascade, map: "devices_ownerId_fkey")
  siteId           String
  site             NetworkSite    @relation(fields: [siteId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "devices_site_owner_fkey")
  ports            DevicePort[]
  topologyLinksAsA TopologyLink[] @relation("TopologyLinkADevice")
  topologyLinksAsZ TopologyLink[] @relation("TopologyLinkZDevice")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([siteId, name])
  @@unique([siteId, ip])
  @@index([ownerId])
  @@index([siteId])
  @@index([siteId, type])
  @@index([status])
  @@map("devices")
}

model DevicePort {
  id               Int             @id @default(autoincrement())
  deviceId         Int
  device           Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ifIndex          Int?
  name             String          @db.VarChar(100)
  macAddress       String?         @db.VarChar(17)
  adminStatus      PortAdminStatus @default(UNKNOWN)
  operStatus       PortOperStatus  @default(UNKNOWN)
  speedMbps        Int?
  duplex           PortDuplex      @default(UNKNOWN)
  poeStatus        PoeStatus       @default(UNKNOWN)
  nativeVlanId     Int?
  lagId            String?         @db.VarChar(100)
  lastSeenAt       DateTime?
  topologyLinksAsA TopologyLink[]  @relation("TopologyLinkAPort")
  topologyLinksAsZ TopologyLink[]  @relation("TopologyLinkZPort")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([deviceId, name])
  @@unique([deviceId, ifIndex])
  @@index([deviceId, operStatus])
  @@map("device_ports")
}

model TopologyLink {
  id              String             @id @default(cuid())
  siteId          String
  site            NetworkSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  aDeviceId       Int
  aDevice         Device             @relation("TopologyLinkADevice", fields: [aDeviceId], references: [id], onDelete: Cascade)
  aPortId         Int?
  aPort           DevicePort?        @relation("TopologyLinkAPort", fields: [aPortId], references: [id], onDelete: SetNull)
  zDeviceId       Int
  zDevice         Device             @relation("TopologyLinkZDevice", fields: [zDeviceId], references: [id], onDelete: Cascade)
  zPortId         Int?
  zPort           DevicePort?        @relation("TopologyLinkZPort", fields: [zPortId], references: [id], onDelete: SetNull)
  canonicalKey    String             @unique @db.VarChar(160)
  linkType        TopologyLinkType   @default(ETHERNET)
  discoverySource DiscoverySource    @default(MANUAL)
  status          TopologyLinkStatus @default(UNKNOWN)
  speedMbps       Int?
  confidence      Float              @default(1)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([siteId, status])
  @@index([aDeviceId])
  @@index([zDeviceId])
  @@index([lastSeenAt])
  @@map("topology_links")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique @db.VarChar(50)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @db.VarChar(255)
  displayName   String?        @db.VarChar(100)
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?
  devices       Device[]       @relation("UserDevices")
  sites         NetworkSite[]  @relation("UserSites")
  auditLogs     AuditLog[]
  aiTasks       AiTask[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@map("users")
}
