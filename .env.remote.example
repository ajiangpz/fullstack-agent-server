# Copy this file to .env.remote.local and fill in the deployment host details.
# Keep credentials in environment variables or a secrets manager.
REMOTE_SSH_HOST=
REMOTE_SSH_USER=
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432
LOCAL_DB_TUNNEL_PORT=55432
LOCAL_STUDIO_DB_TUNNEL_PORT=55433
REMOTE_REDIS_HOST=127.0.0.1
REMOTE_REDIS_PORT=6379
LOCAL_REDIS_TUNNEL_PORT=56379
REDIS_PASSWORD=

# AI provider: use "mock" for local development or "openai" for real requests.
AI_PROVIDER=mock
MOCK_AI_DELAY_MS=500
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional for OpenAI-compatible gateways. Omit for the official OpenAI API.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_INSTRUCTIONS=
